# Database
DATABASE_URL="postgresql://user:password@localhost:5432/jewellers_db"

# NextAuth / Auth.js
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay (Test Keys - swap with production keys for live)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="test_xxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="webhook_secret_xxxxxxxxxxxxx"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Email Configuration (Nodemailer / SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="noreply@jewellery-store.com"
SMTP_FROM_NAME="Jewellery Store"

# Email Service (optional - for transactional emails)
SENDGRID_API_KEY="your_sendgrid_key"

# Admin Credentials (Initial Setup)
ADMIN_EMAIL="admin@jewellery-store.com"
ADMIN_PASSWORD="secure-password-here"

# Feature Flags
FEATURE_COD_ENABLED="true"
FEATURE_REVIEWS_ENABLED="true"
FEATURE_WISHLIST_ENABLED="true"

# Store Configuration
STORE_NAME="Jewellery Store"
STORE_EMAIL="contact@jewellery-store.com"
STORE_PHONE="+91-1234567890"
STORE_ADDRESS="123 Luxury Lane, New Delhi, India"

# Commerce Settings
GST_RATE="18"
FREE_SHIPPING_THRESHOLD="5000"
STANDARD_SHIPPING_CHARGE="150"
CURRENCY="INR"
